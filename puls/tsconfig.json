{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "rootDir": "app/src",
    "outDir": "app/dist",
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["app/src/**/*.ts"]
}
