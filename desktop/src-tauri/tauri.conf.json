{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arbor",
  "version": "2.0.0",
  "identifier": "app.arbor.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Arbor",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Apprendre, comprendre, pratiquer, maîtriser",
    "longDescription": "Arbor transforme des connaissances en compréhension réelle, en compétences démontrables et en maîtrise durable.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Arbor"
}